# SQLite database file used by Prisma. No external database needed.
DATABASE_URL="file:./dev.db"

# Secret used to sign client session cookies. Change this in any real deployment.
SESSION_SECRET="dev-only-change-me-session-secret"

# Password that gates /admin. Change this in any real deployment.
ADMIN_PASSWORD="admin123"

# When "true", shortens the audit run to ~10s instead of ~60-90s. Handy for demos/testing.
AUDIT_DEMO_FAST="false"
