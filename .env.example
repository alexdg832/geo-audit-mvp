# Postgres connection strings (pooled + direct). In production these come from
# the Neon integration on Vercel. For local dev, point these at any Postgres
# database (e.g. a free Neon project, or `docker run postgres`).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign client session cookies. Change this in any real deployment.
SESSION_SECRET="dev-only-change-me-session-secret"

# Password that gates /admin. Change this in any real deployment.
ADMIN_PASSWORD="admin123"

# --- AI engine provider keys. Server-side only; never prefix with NEXT_PUBLIC_. ---
# Each engine is enabled only when its key is present; a missing key marks that
# engine "not_configured" and the scan proceeds with whatever engines are live.

# OpenAI (ChatGPT adapter — Responses API with the web_search tool for citations)
OPENAI_API_KEY=

# Anthropic (Claude adapter — Messages API with the web_search server tool)
CLAUDE_API_KEY=

# Google (Gemini adapter — Gemini API with Google Search grounding)
GEMINI_API_KEY=

# Perplexity (Sonar API — returns citations natively)
PERPLEXITY_API_KEY=

# --- Email (Resend) and scheduling ---

# Resend API key. Sends the team alerts (new audit, new lead, support messages), the
# client welcome email and the email copies of support replies. Unset = every email is
# recorded as "skipped" in the admin log and nothing is sent.
RESEND_API_KEY=

# Where team alerts go (new audit started, new lead, new support message). It is also the
# reply-to on client emails; without it clients are only pointed at the dashboard, never
# told to "reply to this email". Until a domain is verified in Resend this MUST be the
# address that owns the Resend account, or the alerts are refused (see RESEND_FROM_EMAIL).
ADMIN_NOTIFY_EMAIL=

# Sender shown on outgoing email. Leave unset until you have verified a domain at
# resend.com/domains: Resend then uses its sandbox sender (any @resend.dev address counts,
# including onboarding@resend.dev set here by hand), which can only deliver to the address
# that owns the Resend account: client emails fail with a 403, and team alerts only arrive
# when ADMIN_NOTIFY_EMAIL is that same address.
# RESEND_FROM_EMAIL="TrueSource <hello@yourdomain.com>"

# Public base URL used for links inside emails. Without it a Vercel Production deployment
# uses the project's production URL and a Preview deployment uses its own URL (so links in
# emails sent from a Preview sit behind Vercel's deployment protection); anything else
# falls back to http://localhost:3000.
# APP_URL=https://yourdomain.com

# Scheduling link shown to clients. Public by nature, so the NEXT_PUBLIC_ prefix is fine.
# It is inlined into the browser bundle at build time, so set it before building and
# redeploy after changing it. Unset = no booking link anywhere (no placeholder); clients who
# ask for a call are told we will email them to pick a time, and the team alert says so.
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/intro-call

# When "true", the whole audit flow runs on labelled fixture data with no provider
# keys. For local development only; refused on a deployed Vercel environment.
MOCK_MODE=false

# Optional model overrides (defaults live in src/lib/providers/*.ts).
# OPENAI_MODEL=
# OPENAI_FAST_MODEL=
# ANTHROPIC_MODEL=
# ANTHROPIC_FAST_MODEL=
# GEMINI_MODEL=
# GEMINI_FAST_MODEL=
# PERPLEXITY_MODEL=

# Optional rate limits for anonymous scan starts (per hashed IP, and global) per hour.
# SCAN_PER_IP_HOURLY_LIMIT=3
# SCAN_GLOBAL_HOURLY_LIMIT=30
