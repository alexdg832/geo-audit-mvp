# Postgres connection strings (pooled + direct). In production these come from
# the Neon integration on Vercel. For local dev, point these at any Postgres
# database (e.g. a free Neon project, or `docker run postgres`).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign client session cookies. Change this in any real deployment.
SESSION_SECRET="dev-only-change-me-session-secret"

# Password that gates /admin. Change this in any real deployment.
ADMIN_PASSWORD="admin123"

# When "true", shortens the audit run to ~10s instead of ~60-90s. Handy for demos/testing.
AUDIT_DEMO_FAST="false"

# --- AI engine provider keys. Server-side only; never prefix with NEXT_PUBLIC_. ---
# Each engine is enabled only when its key is present; a missing key marks that
# engine "not_configured" and the scan proceeds with whatever engines are live.

# OpenAI (ChatGPT adapter — Responses API with the web_search tool for citations)
OPENAI_API_KEY=

# Anthropic (Claude adapter — Messages API with the web_search server tool)
CLAUDE_API_KEY=

# Google (Gemini adapter — Gemini API with Google Search grounding)
GEMINI_API_KEY=

# Perplexity (Sonar API — returns citations natively)
PERPLEXITY_API_KEY=

# Resend — transactional email for report delivery and contact notifications
RESEND_API_KEY=

# When "true", the whole audit flow runs on labeled fixture data with no provider
# keys. For local development only; must never be enabled on a real deployment.
MOCK_MODE=false
